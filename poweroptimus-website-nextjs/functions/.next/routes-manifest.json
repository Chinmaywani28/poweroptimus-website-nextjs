      "regex": "^/resources/blogs\\-details/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPblogId": "nxtPblogId"
      },
      "namedRegex": "^/resources/blogs\\-details/(?<nxtPblogId>[^/]+?)(?:/)?$"
    },
