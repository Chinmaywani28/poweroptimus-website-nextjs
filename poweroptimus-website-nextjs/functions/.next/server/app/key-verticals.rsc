c:["$","section",null,{"className":"facility-section","children":["$","div",null,{"className":"facility-content ","children":[["$","div",null,{"className":"facility-image","children":["$","img",null,{"src":"/Industrial Plants and Factories- Key Verticals1.jpg","alt":"Industrial Plants & Factories"}]}],["$","div",null,{"className":"facility-text","children":[["$","div",null,{"className":"Header2 TextBlue marBtm","children":"Industrial Plants & Factories"}],["$","div",null,{"className":"body2 marTopGlobal","children":["In energy-intensive plants, even small inefficiencies can quickly escalate into major cost overruns and higher carbon emissions. Advanced energy monitoring delivers granular visibility into every unit consumed across production lines, HVAC systems, and compressors, enabling facilities to identify waste, optimize workflows, and increase output. By pairing operational KPIs with real-time compliance and safety tracking, a Sustainable Energy Management Platform enables industries to move beyond reactive fixes to proactive efficiency ensuring both profitability and sustainability.",["$","ul",null,{"className":"listStyleGlobal","children":["$undefined","$undefined","$undefined","$undefined"]}]]}],["$","div",null,{"className":"tags marTopGlobal","children":[["$","$L19",null,{"href":"/key-verticals/capabilities/#compressor-management","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Compressor Management"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#advanced-hvac","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"HVAC"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#boiler-optimization","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Boiler Optimization"}]}]]}]]}]]}]}]
d:["$","section",null,{"className":"facility-section","children":["$","div",null,{"className":"facility-content reverse","children":[["$","div",null,{"className":"facility-image","children":["$","img",null,{"src":"/Data Center - Key Verticals 1.jpg","alt":"Large Infrastructure"}]}],["$","div",null,{"className":"facility-text","children":[["$","div",null,{"className":"Header2 TextBlue marBtm","children":"Large Infrastructure"}],["$","div",null,{"className":"body2 marTopGlobal","children":["Facilities such as data centers, airports, and transport hubs require structured energy and environmental management to meet high-power demand and comply with regulatory requirements. Common challenges include power-quality fluctuations, cooling inefficiencies, peak-demand penalties, emissions-tracking gaps, and limited visibility across distributed assets. An Environment & Energy Management System (EEMS) addresses these issues through granular, real-time monitoring and analytics, enabling load optimization, improved cooling performance, carbon management, and compliance reporting — supporting efficient and stable operations.",["$","ul",null,{"className":"listStyleGlobal","children":["$undefined","$undefined","$undefined","$undefined"]}]]}],["$","div",null,{"className":"tags marTopGlobal","children":[["$","$L19",null,{"href":"/key-verticals/capabilities/#advanced-hvac","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"HVAC"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#air-quality","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Energy Monitoring"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#compressor-management","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Compressor Management"}]}]]}]]}]]}]}]
e:["$","section",null,{"className":"facility-section","children":["$","div",null,{"className":"facility-content ","children":[["$","div",null,{"className":"facility-image","children":["$","img",null,{"src":"/key-vertical-hospital.jpg","alt":"Hospitals and Healthcare Facilities"}]}],["$","div",null,{"className":"facility-text","children":[["$","div",null,{"className":"Header2 TextBlue marBtm","children":"Hospitals and Healthcare Facilities"}],["$","div",null,{"className":"body2 marTopGlobal","children":["Hospitals and Healthcare facilities cannot afford downtime, reliability and compliance are non-negotiable. Real-time monitoring of energy, HVAC, indoor air quality, and occupancy creates safe, stable environments while reducing operating costs. Insights into power fluctuations or anomalies help avoid risks that could compromise life-saving equipment. By embedding energy intelligence into daily operations, healthcare providers enhance patient care, ensure regulatory compliance, and contribute to broader sustainability goals.",["$","ul",null,{"className":"listStyleGlobal","children":["$undefined","$undefined","$undefined","$undefined"]}]]}],["$","div",null,{"className":"tags marTopGlobal","children":[["$","$L19",null,{"href":"/key-verticals/capabilities/#air-quality","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Air Quality Monitoring"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#advanced-hvac","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"HVAC"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#boiler-optimization","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Boiler Optimization"}]}]]}]]}]]}]}]
f:["$","section",null,{"className":"facility-section","children":["$","div",null,{"className":"facility-content reverse","children":[["$","div",null,{"className":"facility-image","children":["$","img",null,{"src":"/Pharmaceuticals & Life Science - Key Verticals.jpg","alt":"Pharmaceuticals and Life Sciences"}]}],["$","div",null,{"className":"facility-text","children":[["$","div",null,{"className":"Header2 TextBlue marBtm","children":"Pharmaceuticals and Life Sciences"}],["$","div",null,{"className":"body2 marTopGlobal","children":["In Pharmaceuticals and Life Sciences, environmental precision is directly linked to product quality and compliance. Automated monitoring of temperature, humidity, cleanroom conditions, and lab equipment energy use helps maintain regulatory standards while safeguarding sensitive products. Real-time analytics allow teams to detect deviations instantly, minimizing risks of contamination or non-compliance. At the same time, optimization of utilities across R&D labs and production sites drives efficiency, reduces costs, and supports sustainable innovation.",["$","ul",null,{"className":"listStyleGlobal","children":["$undefined","$undefined","$undefined","$undefined"]}]]}],["$","div",null,{"className":"tags marTopGlobal","children":[["$","$L19",null,{"href":"/key-verticals/capabilities/#advanced-hvac","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"HVAC"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#hazardous-gas","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Hazardous Gas Monitoring"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#air-quality","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Air Quality Monitoring"}]}]]}]]}]]}]}]
10:["$","section",null,{"className":"facility-section","children":["$","div",null,{"className":"facility-content ","children":[["$","div",null,{"className":"facility-image","children":["$","img",null,{"src":"/Food & Beverages - Key Verticals.jpg","alt":"Food and Beverage Industry"}]}],["$","div",null,{"className":"facility-text","children":[["$","div",null,{"className":"Header2 TextBlue marBtm","children":"Food and Beverage Industry"}],["$","div",null,{"className":"body2 marTopGlobal","children":["The Food and Beverage sector depends on consistent quality, safety, and efficiency. Monitoring refrigeration systems, HVAC, energy use, and production KPIs ensures product integrity while minimizing energy waste and operational costs. With real-time insights, facilities can better manage distributed plants, streamline utilities, and reduce their carbon footprint. This integrated approach not only helps maintain health and safety standards but also aligns operations with growing consumer and regulatory demand for sustainable production practices.",["$","ul",null,{"className":"listStyleGlobal","children":["$undefined","$undefined","$undefined","$undefined"]}]]}],["$","div",null,{"className":"tags marTopGlobal","children":[["$","$L19",null,{"href":"/key-verticals/capabilities/#boiler-optimization","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Boiler Optimization"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#hazardous-gas","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Hazardous Gas Monitoring"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#advanced-hvac","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"HVAC"}]}]]}]]}]]}]}]
