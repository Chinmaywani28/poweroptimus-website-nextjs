f:["$","section",null,{"className":"facility-section","children":["$","div",null,{"className":"facility-content ","children":[["$","div",null,{"className":"facility-image","children":["$","img",null,{"src":"/Key Verticals- Industrial Plants and Factory.jpg","alt":"Industrial Plants & Factories"}]}],["$","div",null,{"className":"facility-text","children":[["$","div",null,{"className":"Header2 TextBlue marBtm","children":"Industrial Plants & Factories"}],["$","div",null,{"className":"Header3 TextBlue marBtm","children":"Automobile, Heavy Engineering, General Engineering, OEM, Chemical, Food and Beverages, Cement, Metal and Mineral, Pharma, Cold Storage"}],["$","div",null,{"className":"body2 marTopGlobal","children":["Enable emissions control through corrective actions, process-level energy optimization, and regulatory compliance, achieved through asset-level monitoring, KPI Mapping, and environmental performance analytics. We enable HAZOP study, ISO 14001 Certification, ISO 50001 Certification, ISO 45001 Certification.",["$","ul",null,{"className":"listStyleGlobal","children":["$undefined","$undefined","$undefined","$undefined"]}]]}],["$","ul",null,{"style":{"marginTop":0,"marginBottom":0},"children":[["$","li","0",{"className":"body2 marTopGlobal","children":"Continuous emissions tracking and regulatory reporting"}],["$","li","1",{"className":"body2 marTopGlobal","children":"Correlation of energy usage with production KPIs"}],["$","li","2",{"className":"body2 marTopGlobal","children":"Reduced process energy waste"}],["$","li","3",{"className":"body2 marTopGlobal","children":"Improved resource efficiency and waste reduction"}],["$","li","4",{"className":"body2 marTopGlobal","children":"Lower compliance and operational risk"}]]}],["$","div",null,{"className":"body2 marTopGlobal","children":"Industrial facilities face strict environmental regulations and energy-intensive production cycles. EnvirOptimus provides asset- and process-level environmental and energy visibility, helping industries control emissions, optimize production efficiency, and maintain regulatory adherence. This evolution marked a significant shift towards digitized workflows and standardized documentation, laying the foundation for modern industrial communication and data-driven decision-making."}],["$","div",null,{"className":"tags marTopGlobal","children":[["$","$L19",null,{"href":"/key-verticals/capabilities/#hazardous-gas","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Compressor Management"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#occu","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"HVAC"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#advanced-hvac","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Boiler Optimization"}]}]]}]]}]]}]}]
10:["$","section",null,{"className":"facility-section","children":["$","div",null,{"className":"facility-content reverse","children":[["$","div",null,{"className":"facility-image","children":["$","img",null,{"src":"/Key Verticals- Large Critical Infrast.jpg","alt":"Large Critical Infrastructure"}]}],["$","div",null,{"className":"facility-text","children":[["$","div",null,{"className":"Header2 TextBlue marBtm","children":"Large Critical Infrastructure"}],["$","div",null,{"className":"Header3 TextBlue marBtm","children":"Data Centers, Airports & Transport Hubs"}],["$","div",null,{"className":"body2 marTopGlobal","children":["Ensure power reliability, thermal management optimization, and environmental compliance across high-density, distributed infrastructure environments. Real-time PUE (Power Usage Effectiveness) , Peak-demand penalty avoidance.",["$","ul",null,{"className":"listStyleGlobal","children":["$undefined","$undefined","$undefined","$undefined"]}]]}],["$","ul",null,{"style":{"marginTop":0,"marginBottom":0},"children":[["$","li","0",{"className":"body2 marTopGlobal","children":"Structured environmental monitoring and reporting"}],["$","li","1",{"className":"body2 marTopGlobal","children":"Cooling and thermal optimization"}],["$","li","2",{"className":"body2 marTopGlobal","children":"Improved power load visibility and reliability"}],["$","li","3",{"className":"body2 marTopGlobal","children":"Reduced operational disruptions"}],["$","li","4",{"className":"body2 marTopGlobal","children":"Controlled carbon and environmental impact"}]]}],["$","div",null,{"className":"body2 marTopGlobal","children":"Large infrastructure assets require continuous environmental oversight alongside energy management. EnvirOptimus centralizes visibility across distributed systems, enabling operators to optimize cooling, balance loads, and manage compliance without compromising stability.    Modern infrastructure environments generate vast volumes of operational and environmental data that must be continuously monitored, analyzed, and acted upon in real time. By integrating diverse systems into a unified platform, organizations can gain actionable insights, improve efficiency, and maintain operational resilience. This approach supports proactive decision-making, enhances system performance, and ensures long-term sustainability while adapting to evolving regulatory and operational demands."}],["$","div",null,{"className":"tags marTopGlobal","children":[["$","$L19",null,{"href":"/key-verticals/capabilities/#hazardous-gas","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"HVAC"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#occu","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Energy Monitoring"}]}],["$","$L19",null,{"href":"/key-verticals/capabilities/#advanced-hvac","style":{"textDecoration":"none"},"children":["$","span",null,{"className":"body2sec","children":"Compressor Management"}]}]]}]]}]]}]}]
