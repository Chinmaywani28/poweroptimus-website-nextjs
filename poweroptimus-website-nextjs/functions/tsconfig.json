{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "skipLibCheck": true,
  },
  "compileOnSave": true,
  "include": ["./index.ts"],       // 🔥 Only include our function
  "exclude": ["node_modules"] 
}
